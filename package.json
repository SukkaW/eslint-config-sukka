{
  "name": "eslint-config-sukka-monorepo",
  "version": "9.1.0",
  "private": true,
  "description": "",
  "scripts": {
    "build": "turbo build",
    "codegen": "turbo codegen",
    "test": "turbo test",
    "lint": "turbo run lint:root",
    "lint:root": "eslint --format=sukka .",
    "typecheck": "tsc --build --noEmit",
    "prerelease": "pnpm run build && pnpm run typecheck && pnpm run lint",
    "release": "bumpp --install -r --all --commit \"release: %s\" --tag \"%s\""
  },
  "keywords": [],
  "author": "Sukka <https://skk.moe>",
  "license": "MIT",
  "devDependencies": {
    "@eslint-sukka/node": "workspace:*",
    "@eslint-sukka/react": "workspace:*",
    "@eslint-sukka/shared": "workspace:*",
    "@eslint-sukka/yaml": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@types/node": "^24.19.1",
    "@types/stringify-object": "^4.0.5",
    "bumpp": "^10.4.1",
    "eslint": "^10.12.0",
    "eslint-config-sukka": "workspace:*",
    "eslint-formatter-sukka": "workspace:*",
    "foxts": "^5.9.1",
    "rollup": "^4.64.0",
    "stringify-object": "5.0.0",
    "ts-dedent": "^2.3.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.28.3"
